{
  "name": "type-a-house-organizer",
  "version": "2.1.0",
  "description": "Cozy drag-and-drop puzzle - mobile-ready v2.1, larger objects for phones & laptops, clean responsive layout, one-link sharing. No build step.",
  "type": "module",
  "scripts": {
    "start": "npx serve . -l 3000 --cors",
    "serve": "npx serve . -l 3000 --cors",
    "dev": "npx serve . -l 3000 --cors",
    "tunnel": "npx localtunnel --port 3000",
    "share": "npm run serve & npx localtunnel --port 3000",
    "deploy:netlify": "npx netlify-cli deploy --dir=. --prod",
    "deploy:vercel": "npx vercel --prod"
  },
  "keywords": ["game", "puzzle", "mobile", "responsive", "pwa", "laptop", "touch"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "serve": "^14.2.0"
  },
  "dependencies": {}
}
